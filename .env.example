# Standalone privado. Hatchable usa seu SDK, autenticação e cofre próprios.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
PUBLIC_APP_URL=http://127.0.0.1:3000
PGLITE_DATA_DIR=data/radar-promo
STANDALONE_SCHEDULER_ENABLED=true
# Produção: secret aleatório >=32 caracteres, identidade fixa e HTTPS no proxy.
STANDALONE_AUTH_SECRET=
STANDALONE_USER_ID=
STANDALONE_USER_NAME=Radar Admin
STANDALONE_USER_EMAIL=
# Apenas se houver um proxy confiável; informar quantidade real de saltos.
TRUST_PROXY_HOPS=

# Texto IA; suporte local: Gemini. Modelos da hospedagem dependem do provedor ativo.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Cartão fallback local: instalar Chromium via npx playwright install chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Ponte n8n: segredo principal nunca é enviado ao cliente. Chave derivada por conta.
N8N_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN_1=
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_BOT_TOKEN_3=
# Token global tem um único proprietário por slot; outras contas precisam de slots próprios.

# Mercado Livre OAuth e criptografia AES-GCM. Usar chave aleatória e guardar backup seguro.
MELI_APP_ID=
MELI_CLIENT_SECRET=
CONNECTOR_ENCRYPTION_KEY=
meli_redirect_uri=
# Os aliases MERCADOLIVRE_CLIENT_ID/SECRET/REDIRECT_URI são aceitos no standalone.

# Recursos opcionais; só aparecem como testados após verificação real.
RUNWAY_API_KEY=
META_PAGE_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
RESEND_API_KEY=
EMAIL_FROM=

# Token Bearer da API standalone (diferente da senha)
STANDALONE_API_TOKEN=
