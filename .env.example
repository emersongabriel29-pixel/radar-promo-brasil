# Radar Promo Brasil — Variáveis de Ambiente e Integrações
PORT=3000
NODE_ENV=development

# Inteligência Artificial (Google Gemini API)
# Obtenha sua chave no Google AI Studio (https://aistudio.google.com/app/apikey)
# Usado para redação de copies persuasivas e categorização automática (Gemini 3.8 Flash)
GEMINI_API_KEY=

# Integração Webhook n8n (WhatsApp / Automação Externa)
# Chave secreta HMAC (SHA-256) para autenticar a ponte n8n (/api/n8n/bridge)
N8N_WEBHOOK_SECRET=

# Bots do Telegram (BotFather)
# Tokens para envio automático de ofertas com fotos, botões e links
TELEGRAM_BOT_TOKEN_1=
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_BOT_TOKEN_3=

# Integrações de Marketplaces e Afiliados (Opcional)
AMAZON_AFFILIATE_TAG=
SHOPEE_AFFILIATE_TAG=
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=
