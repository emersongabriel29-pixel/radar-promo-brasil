# Copy to .env on the server; never commit the real .env.
# A DNS A record for this hostname must point to the server's public IP.
N8N_HOST=n8n.example.com
ACME_EMAIL=admin@example.com

# Set to an explicitly tested n8n version before production.
# 'stable' is convenient for first boot but is not a reproducible production pin.
N8N_IMAGE_TAG=stable

# Generate a unique random secret with at least 32 bytes of entropy.
# Example generator: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_SECRET
