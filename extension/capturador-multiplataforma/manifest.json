{
  "manifest_version": 3,
  "name": "Radar Promo Brasil — Capturador Multiplataforma",
  "version": "1.5.0",
  "description": "Captura ofertas ao copiar links de afiliado e identifica marketplaces automaticamente.",
  "permissions": ["activeTab", "storage", "downloads", "tabs", "clipboardRead"],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*", "https://*.mercadolibre.com/*", "https://meli.la/*",
    "https://*.amazon.com.br/*", "https://*.amazon.com/*", "https://amzn.to/*", "https://a.co/*",
    "https://*.shopee.com.br/*", "https://shope.ee/*",
    "https://*.aliexpress.com/*",
    "https://*.temu.com/*",
    "https://*.shein.com/*", "https://*.br.shein.com/*",
    "https://*.magazineluiza.com.br/*", "https://*.magalu.com/*"
  ],
  "action": {"default_title":"Radar Promo Brasil","default_popup":"popup.html"},
  "background":{"service_worker":"background.js"},
  "content_scripts":[{
    "matches":[
      "https://*.mercadolivre.com.br/*","https://*.mercadolibre.com/*","https://meli.la/*",
      "https://*.amazon.com.br/*","https://*.amazon.com/*","https://amzn.to/*","https://a.co/*",
      "https://*.shopee.com.br/*","https://shope.ee/*","https://*.aliexpress.com/*",
      "https://*.temu.com/*","https://*.shein.com/*","https://*.br.shein.com/*",
      "https://*.magazineluiza.com.br/*","https://*.magalu.com/*"
    ],
    "js":["content.js"],"run_at":"document_idle"
  }]
}