{
  "manifest_version": 3,
  "name": "Radar Promo Brasil — Capturador Multiplataforma",
  "version": "1.1.2",
  "description": "Captura ofertas e envia ao endpoint HTTPS configurado do Radar.",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com/*",
    "https://*.amazon.com.br/*",
    "https://*.amazon.com/*",
    "https://*.temu.com/*",
    "https://*.shein.com/*",
    "https://*.br.shein.com/*",
    "https://*.magazineluiza.com.br/*",
    "https://*.magalu.com/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Radar Promo Brasil",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com/*",
        "https://*.amazon.com.br/*",
        "https://*.amazon.com/*",
        "https://*.temu.com/*",
        "https://*.shein.com/*",
        "https://*.br.shein.com/*",
        "https://*.magazineluiza.com.br/*",
        "https://*.magalu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
